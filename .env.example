# Copy this file to .env only for local use. Never commit real cookies.
#
# Values come from your logged-in x.com browser cookies:
# - auth_token -> X_AUTH_TOKEN
# - ct0        -> X_CT0

X_AUTH_TOKEN=replace-with-your-auth_token-cookie
X_CT0=replace-with-your-ct0-cookie

# Optional. Normally x-listcopy discovers the current public web bearer token automatically.
# X_BEARER_TOKEN=
